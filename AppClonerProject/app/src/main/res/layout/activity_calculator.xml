<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- Màn hình hiển thị phép tính &amp; kết quả -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B0BEC5"
            android:textSize="24sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Bàn phím số &amp; phép tính ngụy trang -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:columnCount="4"
        android:rowCount="5"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false">

        <!-- Hàng 1 -->
        <Button android:id="@+id/btnClear" android:text="C" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#D32F2F" android:textColor="#FFF" android:textSize="20sp" />
        <Button android:id="@+id/btnDelete" android:text="DEL" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#455A64" android:textColor="#FFF" android:textSize="18sp" />
        <Button android:id="@+id/btnDiv" android:text="÷" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#FF9800" android:textColor="#FFF" android:textSize="22sp" />
        <Button android:id="@+id/btnMul" android:text="×" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#FF9800" android:textColor="#FFF" android:textSize="22sp" />

        <!-- Hàng 2 -->
        <Button android:id="@+id/btn7" android:text="7" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#263238" android:textColor="#FFF" android:textSize="22sp" />
        <Button android:id="@+id/btn8" android:text="8" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#263238" android:textColor="#FFF" android:textSize="22sp" />
        <Button android:id="@+id/btn9" android:text="9" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#263238" android:textColor="#FFF" android:textSize="22sp" />
        <Button android:id="@+id/btnSub" android:text="-" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#FF9800" android:textColor="#FFF" android:textSize="24sp" />

        <!-- Hàng 3 -->
        <Button android:id="@+id/btn4" android:text="4" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#263238" android:textColor="#FFF" android:textSize="22sp" />
        <Button android:id="@+id/btn5" android:text="5" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#263238" android:textColor="#FFF" android:textSize="22sp" />
        <Button android:id="@+id/btn6" android:text="6" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#263238" android:textColor="#FFF" android:textSize="22sp" />
        <Button android:id="@+id/btnAdd" android:text="+" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#FF9800" android:textColor="#FFF" android:textSize="22sp" />

        <!-- Hàng 4 -->
        <Button android:id="@+id/btn1" android:text="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#263238" android:textColor="#FFF" android:textSize="22sp" />
        <Button android:id="@+id/btn2" android:text="2" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#263238" android:textColor="#FFF" android:textSize="22sp" />
        <Button android:id="@+id/btn3" android:text="3" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#263238" android:textColor="#FFF" android:textSize="22sp" />
        <Button android:id="@+id/btnEqual" android:text="=" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="2" android:layout_margin="4dp" android:backgroundTint="#4CAF50" android:textColor="#FFF" android:textSize="26sp" />

        <!-- Hàng 5 -->
        <Button android:id="@+id/btn0" android:text="0" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="2" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#263238" android:textColor="#FFF" android:textSize="22sp" />
        <Button android:id="@+id/btnDot" android:text="." android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="4dp" android:backgroundTint="#263238" android:textColor="#FFF" android:textSize="22sp" />
    </GridLayout>
</LinearLayout>
