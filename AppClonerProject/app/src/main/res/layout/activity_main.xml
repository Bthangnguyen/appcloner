<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1565C0"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Cloner Studio"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Thanh chuyển đổi 2 Tab -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnTabApps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ỨNG DỤNG TRÊN MÁY"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#1976D2" />

            <Button
                android:id="@+id/btnTabCloned"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ỨNG DỤNG ĐÃ CLONE"
                android:textSize="12sp"
                android:textColor="#BBDEFB"
                android:background="#0D47A1" />
        </LinearLayout>
    </LinearLayout>

    <!-- CONTAINER TAB 1: DANH SÁCH ỨNG DỤNG TRÊN MÁY -->
    <LinearLayout
        android:id="@+id/layoutTabApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_margin="10dp"
            android:background="#FFFFFF"
            android:hint="Tìm kiếm ứng dụng cần nhân bản..."
            android:textColor="#212121"
            android:textColorHint="#9E9E9E"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đang tải danh sách ứng dụng..."
            android:textColor="#546E7A"
            android:textSize="12sp"
            android:padding="8dp"
            android:gravity="center"
            android:background="#E1F5FE" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <ListView
            android:id="@+id/lvApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#CFD8DC"
            android:dividerHeight="1dp"
            android:padding="4dp" />
    </LinearLayout>

    <!-- CONTAINER TAB 2: DANH SÁCH ỨNG DỤNG ĐÃ CLONE -->
    <LinearLayout
        android:id="@+id/layoutTabCloned"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:background="#E8EAF6"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvClonedCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh sách tệp APK đã nhân bản"
                android:textColor="#283593"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRefreshCloned"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Làm mới"
                android:textSize="11sp"
                android:background="#3949AB"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Thông báo trống khi chưa có file clone -->
        <TextView
            android:id="@+id/tvEmptyCloned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa có ứng dụng nào được clone.\n\nHãy chuyển sang tab 'ỨNG DỤNG TRÊN MÁY', chọn app bạn muốn và bấm Clone!"
            android:textColor="#78909C"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="36dp"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone" />

        <ListView
            android:id="@+id/lvClonedApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#CFD8DC"
            android:dividerHeight="1dp"
            android:padding="6dp" />
    </LinearLayout>

</LinearLayout>
