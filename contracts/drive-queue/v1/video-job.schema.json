{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subai.local/contracts/drive-queue/v1/video-job.schema.json",
  "title": "SubAI Drive queue video job",
  "description": "Metadata sidecar stored beside a queued video in Google Drive.",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "video_file_id",
    "video_file_name",
    "title",
    "caption",
    "hashtags",
    "target_clone",
    "channel_folder",
    "schedule_time",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "video_file_id": { "type": "string", "minLength": 1 },
    "video_file_name": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "caption": { "type": "string" },
    "hashtags": { "type": "string" },
    "target_clone": { "type": "string", "minLength": 1 },
    "channel_folder": { "type": "string" },
    "schedule_time": {
      "type": "string",
      "pattern": "^(|([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "created_at": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["QUEUED", "CLAIMED", "POSTING", "VERIFYING", "COMPLETED", "FAILED", "REQUIRES_REVIEW"]
    },
    "source": { "type": "string" }
  },
  "additionalProperties": true
}
